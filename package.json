{
  "name": "dmflow",
  "version": "0.1.0",
  "description": "Bilingual Instagram automation workspace with secure Meta integration and durable jobs",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate --schema database/schema.prisma && next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --import tsx workers/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema database/schema.prisma",
    "db:dev": "prisma migrate dev --schema database/schema.prisma",
    "test:integration": "node --import tsx scripts/integration-test.ts",
    "format": "prettier --write app components lib api database workers docs scripts tests README.md next.config.ts tsconfig.json package.json docker-compose.yml .github/workflows/ci.yml"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
